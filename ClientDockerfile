# Production stage
FROM node:18-alpine AS production

WORKDIR /app/client

# Copy package files
COPY c-client/package*.json ./

# Install only production dependencies with legacy peer deps
RUN npm install --only=production --legacy-peer-deps && npm cache clean --force

# Copy built application from builder stage
#comment
COPY --from=builder /app/client/.next/standalone ./
COPY --from=builder /app/client/.next/static ./.next/static
COPY --from=builder /app/client/public ./public
COPY --from=builder /app/c-lib/dist ../c-lib/dist
COPY --from=builder /app/c-lib/package.json /app/client/node_modules/c-lib/package.json
COPY --from=builder /app/c-lib/dist /app/client/node_modules/c-lib/dist

# Create a non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001

# Change ownership of the app directory
RUN chown -R nextjs:nodejs /app
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

# Start the application
CMD ["node", "server.js"]
